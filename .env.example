# Required on Vercel (and local `.env.local`)
DATABASE_URL=

# Gemini — evaluation + full CV rewrite (complex tasks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq — short text improve / tailor snippets (fast tasks)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

MAX_UPLOAD_BYTES=5242880

# Dual host (same Vercel project)
# Local path mode (recommended for npm run dev) — only in `.env.local`, NOT on Vercel:
NEXT_PUBLIC_MAIN_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000/studio

# On Vercel: leave both unset for same-domain /studio path mode (recommended),
# OR set real production domains (never localhost):
# NEXT_PUBLIC_MAIN_URL=https://offerquay.com
# NEXT_PUBLIC_APP_URL=https://app.offerquay.com
# APP_HOST=app.offerquay.com

# Do NOT set NEXT_PUBLIC_API_BASE_URL on Vercel (same-origin /api routes)
