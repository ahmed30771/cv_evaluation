# Required on Vercel (and local `.env.local`)
DATABASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MAX_UPLOAD_BYTES=5242880

# Dual host (same Vercel project)
# Local path mode (recommended for npm run dev):
NEXT_PUBLIC_MAIN_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000/studio

# Production example (add both domains on the same Vercel project):
# NEXT_PUBLIC_MAIN_URL=https://offerquay.com
# NEXT_PUBLIC_APP_URL=https://app.offerquay.com
# APP_HOST=app.offerquay.com

# Do NOT set NEXT_PUBLIC_API_BASE_URL on Vercel (same-origin /api routes)
